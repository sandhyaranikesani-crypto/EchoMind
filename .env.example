# EchoMind environment configuration.
# Copy this file to ".env" (same folder) and fill in your keys.
# The ".env" file is gitignored and is loaded automatically at startup.
# Real environment variables always take precedence over .env values.

# --- Hindsight Cloud -------------------------------------------------------
# Get a key at https://ui.hindsight.vectorize.io (add promo MEMHACK99 in the
# billing section for $50 in free credits).
HINDSIGHT_API_KEY=your-hindsight-cloud-key
# Defaults to Hindsight Cloud; override only if self-hosting:
# HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
# Set true to force the offline in-memory mock (no server calls):
# HINDSIGHT_USE_MOCK=false
# Recall/reflect depth: low | mid | high
# HINDSIGHT_RECALL_BUDGET=mid
# HINDSIGHT_REFLECT_BUDGET=low

# --- LLM (Groq by default) -------------------------------------------------
# Get a key at https://console.groq.com/keys
LLM_API_KEY=your-groq-key
# Groq's OpenAI-compatible endpoint (default). For OpenAI, use
# https://api.openai.com/v1 and an OpenAI key instead.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
