# EchoMind environment configuration.
# Copy this file to ".env" (same folder) and fill in your keys.
# The ".env" file is gitignored and is loaded automatically at startup.
# Real environment variables always take precedence over .env values.

# --- Hindsight Long-Term Memory (Cloud or Self-Hosted) ----------------------
# Get a key at https://ui.hindsight.vectorize.io (use promo MEMHACK99 for $50 free credits).
HINDSIGHT_API_KEY=your-hindsight-cloud-key
# Defaults to Hindsight Cloud; override only if self-hosting:
# HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
# Set true to force the offline in-memory mock (no external calls):
# HINDSIGHT_USE_MOCK=false
# Recall/reflect depth: low | mid | high
# HINDSIGHT_RECALL_BUDGET=mid
# HINDSIGHT_REFLECT_BUDGET=low

# --- LLM Provider Configuration (Optional, Fallback is Deterministic) ------
# EchoMind runs 100% offline with deterministic templates if no LLM key is set.

# Option 1: Groq (Default - Fast with generous free tier)
# Get a key at https://console.groq.com/keys
LLM_PROVIDER=groq
LLM_API_KEY=your-groq-key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Option 2: OpenAI Direct
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Option 3: Azure OpenAI (Optional)
# LLM_PROVIDER=azure
# LLM_API_KEY=your-azure-api-key
# LLM_BASE_URL=https://<your-resource-name>.openai.azure.com/
# LLM_MODEL=<your-deployment-name>
# AZURE_OPENAI_API_VERSION=2024-06-01
